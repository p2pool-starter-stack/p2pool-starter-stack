#!/bin/sh
# Restore this machine's persisted machine-id from /data, or adopt-and-persist the one this boot
# already has if /data holds none yet (#895). Ordering: see pithead-machine-id.service — this
# must land before systemd-networkd (DHCP DUID) and systemd-journal-flush (the persistent
# journal directory name) observe /etc/machine-id, and after /data is mounted.
#
# Why a plain write here works: the image ships /etc/machine-id EMPTY. On a read-only /etc,
# systemd's own early boot (before any unit, ours included, ever runs) detects the empty file
# and bind-mounts a freshly generated, in-memory id from /run/machine-id over /etc/machine-id —
# systemd's documented "volatile" first-boot behaviour for a read-only root (machine-id(5)). That
# bind mount is what makes /etc/machine-id writable here despite the root filesystem being ro;
# nothing in this script (or pithead) needs to prepare an overlay for it. Without the restore
# below, systemd-machine-id-commit never manages to persist that transient id (/etc stays
# read-only for the whole boot), so a NEW random id would otherwise be picked on every single
# boot — worse than the bug being fixed.
set -eu

ID_FILE="${PITHEAD_MACHINE_ID_DATA_DIR:-/data/pithead}/machine-id"
mkdir -p "$(dirname "$ID_FILE")"

if [ -s "$ID_FILE" ]; then
    cat "$ID_FILE" >/etc/machine-id
    echo "pithead-machine-id: restored persisted machine-id from $ID_FILE"
else
    # First boot with nothing on /data yet: adopt whatever systemd already generated for THIS
    # boot rather than minting a second one — one machine, one id, chosen once.
    cp /etc/machine-id "$ID_FILE"
    chmod 444 "$ID_FILE"
    echo "pithead-machine-id: adopted this boot's machine-id and persisted it to $ID_FILE"
fi
