#!/bin/sh
# Generate this machine's SSH host key on /data, once, if none exists yet (#894).
#
# Runs as ExecStartPre on ssh.service (the drop-in: /etc/systemd/system/ssh.service.d/
# pithead-host-keys.conf), so it always runs before sshd tries to load a host key — whether
# ssh.service starts from the operator's ssh.enabled toggle (pithead/provision_ssh_access, which
# owns AUTHORIZED_KEYS — user auth, untouched by this file) or, on a debug image, from being
# enabled outright at build for the test harness.
#
# Baked images ship NO ssh_host_* files: the old baked keys were generated by openssh-server's
# postinst during the Docker build and were therefore extractable from any published release AND
# identical across every machine flashed from it (#894). Generating here, into /data, makes the
# identity per-machine and lets it survive A/B updates and reboots — /data is the single
# persistence root, the same rule Tor's onion identity already follows.
set -eu

# ponytail: env seam so the stack suite can aim this at a sandbox instead of the real /data —
# the same override shape pithead-machine-id carries. sshd's drop-in never sets it.
DIR="${PITHEAD_SSH_HOST_KEYS_DIR:-/data/ssh}"
KEY="$DIR/ssh_host_ed25519_key"

# Already generated — nothing to do. Idempotent so every sshd start (config toggled off then
# back on, a plain reboot) pays this cost at most once per machine.
[ -s "$KEY" ] && exit 0

mkdir -p "$DIR"
chown root:root "$DIR"
chmod 700 "$DIR"
# Clear a stale/partial file first: ssh-keygen prompts to overwrite an EXISTING path, and with
# no terminal attached (systemd feeds ExecStartPre /dev/null on stdin) that prompt reads EOF and
# refuses instead of regenerating — an interrupted prior run would otherwise wedge sshd forever
# rather than just retrying.
rm -f "$KEY" "$KEY.pub"
ssh-keygen -q -t ed25519 -N '' -C '' -f "$KEY"
chown root:root "$KEY" "$KEY.pub"
chmod 600 "$KEY"
chmod 644 "$KEY.pub"
echo "pithead-ssh-host-keys: generated a new host key at $KEY"
