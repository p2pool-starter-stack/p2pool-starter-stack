#!/bin/sh
# systemd generator: mount /data and /boot/efi from THE DISK THE SYSTEM BOOTED FROM.
#
# Never by label. Every pithead disk carries the same labels by design — the installer copies the
# running system — so the moment an install stick and an installed disk are present together,
# LABEL=data resolves to whichever partition udev processed last. The harness caught the stick
# mounting the INTERNAL disk's /data, which made the internal disk look "in use" and blocked the
# reinstall path entirely. The kernel root already follows the disk GRUB chose (probe
# --part-uuid); this generator makes the state mounts follow the same disk.
#
# The partition NUMBERS are fixed by the layout (declared in os/rootfs/repart.d, mkimage.sh and
# pithead-install): 1 = ESP, 2/3 = system slots, 4 = data. On first boot partition 4 may not
# exist yet — systemd-repart creates it — and systemd waits on the device unit exactly as it
# waited on the label, so ordering is unchanged.
#
# NOT consolidated onto lsblk -o PARTLABEL (#926), unlike pithead-data-reset and pithead-install,
# which both resolve the same disk this way. A generator runs before any other unit — including
# systemd-udevd — and per systemd.generator(7) "cannot rely on any external services"; lsblk's
# PARTLABEL column is sourced from the udev database first, falling back to a direct blkid probe
# only once that database is unavailable, and its own man page recommends running `udevadm
# settle` first when it might not be — a settle this generator has no daemon left to run against.
# The awk/sed derivation below touches only /proc and does its own arithmetic, so it owes nothing
# to udev having run yet. Trading that self-containment for the shared shape would be the exact
# kind of behavior-with-an-unprovable-early-boot-dependency this refactor exists to avoid.
set -eu

GENDIR="${1:-/run/systemd/generator}"
# ponytail: env seam so the stack suite can feed a staged mountinfo — an env var, not a second
# positional, because systemd calls generators with THREE dir arguments (and an empty
# environment, so production never sets it).
MOUNTINFO="${PITHEAD_MOUNTINFO:-/proc/self/mountinfo}"

# The device backing / — mountinfo field layout: the filesystem source is the second field
# after the "-" separator. This is the resolved kernel device (e.g. /dev/sda2), not a symlink.
rootsrc=$(awk '$5 == "/" { for (i = 7; i <= NF; i++) if ($i == "-") { print $(i + 2); exit } }' \
    "$MOUNTINFO")
case "$rootsrc" in
/dev/*) ;;
*) exit 0 ;; # container or unexpected root — generate nothing rather than guess
esac

# Parent disk from a partition node: strip the partition number, then the nvme/mmc 'p' separator
# if what remains still ends in a digit (nvme0n1p2 -> nvme0n1, vda2 -> vda, sda2 -> sda).
disk=$(printf '%s' "$rootsrc" | sed -E 's/[0-9]+$//; s/(^.*[0-9])p$/\1/')
case "$disk" in
*[0-9]) sep="p" ;;
*) sep="" ;;
esac

mkdir -p "$GENDIR/local-fs.target.requires"

cat >"$GENDIR/data.mount" <<EOF
# Generated by pithead-mount-generator — the data partition on the boot disk, never by label.
[Unit]
Before=local-fs.target
[Mount]
What=${disk}${sep}4
Where=/data
Type=ext4
Options=defaults,noatime
EOF
ln -sf ../data.mount "$GENDIR/local-fs.target.requires/data.mount"

cat >"$GENDIR/boot-efi.mount" <<EOF
# Generated by pithead-mount-generator — the ESP on the boot disk, never by label. RAUC writes
# boot state to this mount; on the wrong disk's ESP those writes would arm the wrong machine.
[Unit]
Before=local-fs.target
[Mount]
What=${disk}${sep}1
Where=/boot/efi
Type=vfat
Options=umask=0077
EOF
ln -sf ../boot-efi.mount "$GENDIR/local-fs.target.requires/boot-efi.mount"
