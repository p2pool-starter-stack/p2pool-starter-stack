[Unit]
Description=Pithead hugepages sizing — fit the RandomX reservation to this machine's RAM
# After the static sysctl write it corrects, and before either boot owner (the wizard on an
# unprovisioned machine, pithead-boot on a provisioned one) can start a container — the pool is
# idle at this point, so resizing it never steals pages from a running miner.
After=systemd-sysctl.service
Before=pithead-boot.service pithead-firstboot.service

[Service]
Type=oneshot
# Stays 'active' after success so the harness (and an operator) can assert the sizing ran.
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pithead-hugepages

[Install]
WantedBy=multi-user.target
