#!/bin/bash
# Copy the program tree from the system slot onto the data partition, leaving state untouched.
# Runs every boot, so an A/B update delivers its new program the first time the new slot boots.
set -euo pipefail
SRC=/opt/pithead
DST=/data/pithead

mkdir -p "$DST"
for f in pithead pithead-completion.bash VERSION docker-compose.yml \
    config.reference.json config.core-keys.json config.minimal.json cosign.pub; do
    [ -f "$SRC/$f" ] && install -m 644 "$SRC/$f" "$DST/$f"
done
[ -f "$DST/pithead" ] && chmod 755 "$DST/pithead"
# Config templates that services bind-mount: program data, replaced wholesale.
#
# NOT images/: firstboot loads the wizard archive from /opt/pithead/images — the read-only slot —
# so a copy here is never read. Copying it wrote 61 MB to the data partition on EVERY boot, on
# the critical path between power-on and the setup page appearing. On a USB stick that is minutes
# of the silence a first-time operator spends wondering whether the machine is broken.
if [ -d "$SRC/build" ]; then
    rm -rf "${DST:?}/build"
    cp -a "$SRC/build" "$DST/build"
fi
# An images/ copy from an older layout is dead weight on the data partition — reclaim it.
rm -rf "${DST:?}/images"
# repart formats /data with ext4's default 5% root reserve — ~50 GB lost on a 1 TB disk that
# exists to hold chain data. 0.5% keeps a real safety margin (the pre-repart layout used the
# same figure). tune2fs is idempotent and instant, so every boot is the simplest correct hook.
DATA_DEV=$(findmnt -no SOURCE /data 2>/dev/null || true)
[ -n "$DATA_DEV" ] && tune2fs -m 0.5 "$DATA_DEV" >/dev/null 2>&1 || true

echo "pithead-sync: program tree synced to $DST (state preserved)"
