# Input side of the quadlet parity contract: the env values the #78 spike ran with, secrets
# replaced by rendered-* placeholders. `pithead render-quadlet --env fixture.env` must reproduce
# the sibling unit files byte-for-byte (tests/stack). Not a deployable configuration.
PITHEAD_REGISTRY=ghcr.io/p2pool-starter-stack
STACK_VERSION=v1.14.0
NETWORK_PREFIX=172.28.0
NETWORK_SUBNET=172.28.0.0/24
COMPOSE_PROFILES=
DASHBOARD_ONION_ENABLED=false
DASHBOARD_ONION_CLIENT_AUTH=false
TOR_DATA_DIR=/opt/pithead/data/tor
MONERO_NODE_HOST=192.168.1.243
MONERO_RPC_PORT=18081
MONERO_ZMQ_PORT=18083
MONERO_NODE_USERNAME=rendered-node-user
MONERO_NODE_PASSWORD=rendered-node-password
MONERO_WALLET_ADDRESS=your_monero_wallet_address
MONERO_PRUNE=true
MONERO_CLEARNET_SYNC=false
TARI_GRPC_ADDRESS=192.168.1.243:18142
TARI_WALLET_ADDRESS=your_tari_wallet_address
TARI_CLEARNET_SYNC=false
TARI_REQUIRED=true
P2POOL_ONION_ADDRESS=rendered-p2pool-onion.onion
P2POOL_PORT=37888
P2POOL_FLAGS=--mini
P2POOL_URL=172.28.0.28:3333
P2POOL_CLEARNET=true
P2POOL_DATA_DIR=/opt/pithead/data/p2pool
PROXY_API_PORT=3344
PROXY_AUTH_TOKEN=rendered-proxy-token
PROXY_STRATUM_PASSWORD=
PROXY_STRATUM_TLS=false
PROXY_DONATE_LEVEL=0
PROXY_TLS_DIR=/opt/pithead/data/proxy-tls
STRATUM_BIND=0.0.0.0
STRATUM_PORT=3333
HOST_IP=127.0.0.1
DASHBOARD_TZ=Etc/UTC
DASHBOARD_DATA_DIR=/opt/pithead/data/dashboard
DASHBOARD_CHECK_UPDATES=false
DASHBOARD_CONTROL_ENABLED=false
DASHBOARD_FAIL_CLOSED=false
CLEARNET_STATE_DIR=/opt/pithead/data/clearnet-state
CONTROL_DIR=/opt/pithead/data/control
CADDY_LOG_DIR=/opt/pithead/data/caddy-logs
TOR_EGRESS_FIREWALL=false
TOR_AUTO_HEAL=false
XVB_ENABLED=false
XVB_TOR_ENABLED=true
XVB_DONATION_LEVEL=auto
TELEGRAM_ENABLED=false
QUADLET_CADDYFILE=/opt/pithead/Caddyfile
QUADLET_HOST_CONFIG_DIR=/home/pithead
QUADLET_ENGINE_SOCK=/run/podman/podman.sock
