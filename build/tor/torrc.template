# --- General Configuration ---
# Primary storage location for Tor state data and cryptographic keys
DataDirectory /var/lib/tor

# --- Network Interfaces ---
# SOCKS5 proxy interface for routing container traffic through Tor
# Binds to 0.0.0.0 to accept connections from other services in the Docker network
SocksPort 0.0.0.0:9050

# Control interface (required by the Tari base node, which connects from another container).
# Bind explicitly to this container's bridge IP (__NETWORK_PREFIX__.25) + loopback (for the bootstrap
# healthcheck) instead of 0.0.0.0, so the control port isn't auto-exposed on any interface added
# later. The real protection is the cookie auth below: the auth cookie lives in this container's
# private /var/lib/tor volume, so other bridge containers can't read it.
# __NETWORK_PREFIX__ is substituted from the configured bridge subnet at container start (#180).
ControlPort __NETWORK_PREFIX__.25:9051
ControlPort 127.0.0.1:9051

# --- Hidden Services (Onion Routing) ---
# Note: Target IPs (__NETWORK_PREFIX__.x) correspond to static assignments in docker-compose.yml

# Monero P2P Hidden Service
HiddenServiceDir /var/lib/tor/monero/
HiddenServicePort 18080  __NETWORK_PREFIX__.26:18084

# Tari Base Node Hidden Service
HiddenServiceDir /var/lib/tor/tari/
HiddenServicePort 18189  __NETWORK_PREFIX__.27:18189

# P2Pool Hidden Service
HiddenServiceDir /var/lib/tor/p2pool/
HiddenServicePort 37888 __NETWORK_PREFIX__.28:37888

# --- Authentication & Permissions ---
# Enable cookie-based authentication for the Control Port
CookieAuthentication 1
CookieAuthFile /var/lib/tor/control_auth_cookie
# Ensure the auth cookie and data directory are readable by the group (GID 101)
# This facilitates shared access if volumes are mounted with group permissions
CookieAuthFileGroupReadable 1
DataDirectoryGroupReadable 1

# --- Logging ---
# Output logs to stdout for integration with Docker logging drivers
Log notice stdout
